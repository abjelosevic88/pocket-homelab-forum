{
  "name": "Pocket Forum",
  "short_name": "Forum",
  "description": "Forums for your family, club, team or community: topics, replies, questions with answers, events, polls — read where you left off, follow what matters, search everything.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#4361c2",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "New topic",
      "url": "/new"
    },
    {
      "name": "Unread",
      "url": "/?tab=unread"
    },
    {
      "name": "Notifications",
      "url": "/inbox"
    }
  ]
}